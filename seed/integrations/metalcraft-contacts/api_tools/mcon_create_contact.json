{
  "name": "mcon_create_contact",
  "description": "Create a contact. Only `display_name` is required; everything else is optional. Birthday: set `birth_month` (1-12) and `birth_day` (1-31) together; include `birth_year` only if known. `tags` is an array of strings. The repeatable fields are JSON arrays: `phones`/`emails`/`urls` as [{\"label\":\"mobile\",\"value\":\"…\"}], `addresses` as [{\"label\":\"home\",\"street\":\"…\",\"city\":\"…\",\"region\":\"…\",\"postal\":\"…\",\"country\":\"…\"}]. `notes` is markdown. The slug is derived from display_name (auto-deduped). Requires the write scope (403 otherwise). Returns the created contact including its new slug.",
  "method": "POST",
  "url": "https://contacts.metalcraftai.com/api/v1/contacts",
  "headers": {
    "Authorization": "Bearer $METALCRAFT_TOKEN",
    "Content-Type": "application/json",
    "Accept": "application/json"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "display_name": { "type": "string", "description": "The person's name (required)." },
      "given_name": { "type": "string" },
      "family_name": { "type": "string" },
      "nickname": { "type": "string" },
      "organization": { "type": "string" },
      "job_title": { "type": "string" },
      "birth_month": { "type": "integer", "description": "1-12. Set with birth_day." },
      "birth_day": { "type": "integer", "description": "1-31. Set with birth_month." },
      "birth_year": { "type": "integer", "description": "Optional — only if known." },
      "notes": { "type": "string", "description": "Freeform markdown." },
      "tags": { "type": "array", "items": { "type": "string" } },
      "phones": { "type": "array", "items": { "type": "object" }, "description": "[{label,value}]" },
      "emails": { "type": "array", "items": { "type": "object" }, "description": "[{label,value}]" },
      "urls": { "type": "array", "items": { "type": "object" }, "description": "[{label,value}]" },
      "addresses": { "type": "array", "items": { "type": "object" }, "description": "[{label,street,city,region,postal,country}]" }
    },
    "required": ["display_name"]
  },
  "body_mapping": "params"
}
