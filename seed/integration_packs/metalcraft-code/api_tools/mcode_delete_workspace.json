{
  "name": "mcode_delete_workspace",
  "description": "Delete a workspace and tear down its sprite. Irreversible. Requires the write scope.",
  "method": "DELETE",
  "url": "https://code.metalcraftai.com/api/v1/workspaces/{id}",
  "headers": {
    "Authorization": "Bearer $METALCRAFT_TOKEN",
    "Accept": "application/json"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "Workspace id (UUID)."
      }
    },
    "required": [
      "id"
    ]
  },
  "body_mapping": "none"
}
