{
  "name": "discord_get_channel_info",
  "description": "Get metadata about a Discord channel (name, topic, type, etc.).",
  "method": "GET",
  "url": "$AGENT_GATEWAY_URL/api/v1/channels/{channel_id}?platform=discord",
  "headers": {
    "Authorization": "Bearer $AGENT_GATEWAY_API_KEY"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "channel_id": {
        "type": "string",
        "description": "The Discord channel ID"
      }
    },
    "required": ["channel_id"]
  },
  "body_mapping": "none"
}
