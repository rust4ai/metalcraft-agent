{
  "name": "discord_modify_role",
  "description": "Modify a role. Provide `guild_id`, `role_id`, and any of `name`, `permissions` (decimal string), `color`, `hoist`, `mentionable`. Requires MANAGE_ROLES and the role must be below the bot's highest role.",
  "method": "PATCH",
  "url": "https://discord.com/api/v10/guilds/{guild_id}/roles/{role_id}",
  "headers": {
    "Authorization": "Bot $DISCORD_BOT_TOKEN",
    "Content-Type": "application/json"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "guild_id": {
        "type": "string",
        "description": "The guild (server) ID (snowflake)."
      },
      "role_id": {
        "type": "string",
        "description": "The role ID (snowflake)."
      },
      "name": {
        "type": "string",
        "description": "New role name."
      },
      "permissions": {
        "type": "string",
        "description": "Permission bitfield as a decimal string."
      },
      "color": {
        "type": "integer",
        "description": "Integer RGB color."
      },
      "hoist": {
        "type": "boolean",
        "description": "Display members separately."
      },
      "mentionable": {
        "type": "boolean",
        "description": "Whether the role can be @mentioned."
      }
    },
    "required": [
      "guild_id",
      "role_id"
    ]
  },
  "body_mapping": "params"
}
