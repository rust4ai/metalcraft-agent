{
  "name": "discord_modify_channel",
  "description": "Modify a channel. Provide `channel_id` and any of: `name`, `topic`, `position`, `nsfw`, `parent_id`, `rate_limit_per_user`, `bitrate`, `user_limit`. Requires MANAGE_CHANNELS.",
  "method": "PATCH",
  "url": "https://discord.com/api/v10/channels/{channel_id}",
  "headers": {
    "Authorization": "Bot $DISCORD_BOT_TOKEN",
    "Content-Type": "application/json"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "channel_id": {
        "type": "string",
        "description": "The channel ID (snowflake)."
      },
      "name": {
        "type": "string",
        "description": "New channel name."
      },
      "topic": {
        "type": "string",
        "description": "New topic (0-1024 chars)."
      },
      "position": {
        "type": "integer",
        "description": "Sorting position."
      },
      "nsfw": {
        "type": "boolean",
        "description": "Age-restricted flag."
      },
      "parent_id": {
        "type": "string",
        "description": "Category channel ID to move this channel under."
      },
      "rate_limit_per_user": {
        "type": "integer",
        "description": "Slowmode seconds (0-21600)."
      },
      "bitrate": {
        "type": "integer",
        "description": "Voice bitrate in bits (voice channels)."
      },
      "user_limit": {
        "type": "integer",
        "description": "Max users in a voice channel (0 = unlimited)."
      }
    },
    "required": [
      "channel_id"
    ]
  },
  "body_mapping": "params"
}
