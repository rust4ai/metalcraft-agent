{
  "name": "discord_search_members",
  "description": "Search guild members whose username or nickname starts with `query`. Provide `guild_id` and `query`; optional `limit` (1-1000, default 1). Useful to resolve a name to a user id.",
  "method": "GET",
  "url": "https://discord.com/api/v10/guilds/{guild_id}/members/search?query={query}&limit={limit}",
  "headers": {
    "Authorization": "Bot $DISCORD_BOT_TOKEN",
    "Content-Type": "application/json"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "guild_id": {
        "type": "string",
        "description": "The guild (server) ID (snowflake)."
      },
      "query": {
        "type": "string",
        "description": "Username/nickname prefix to search for."
      },
      "limit": {
        "type": "integer",
        "description": "Max results, 1-1000. Defaults to 1."
      }
    },
    "required": [
      "guild_id",
      "query"
    ]
  },
  "body_mapping": "none"
}
