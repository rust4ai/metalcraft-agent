{
  "name": "discord_create_webhook",
  "description": "Create a webhook on a channel. Provide `channel_id` and `name`. Returns the webhook including its token/URL. Requires MANAGE_WEBHOOKS.",
  "method": "POST",
  "url": "https://discord.com/api/v10/channels/{channel_id}/webhooks",
  "headers": {
    "Authorization": "Bot $DISCORD_BOT_TOKEN",
    "Content-Type": "application/json"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "channel_id": {
        "type": "string",
        "description": "The channel ID (snowflake)."
      },
      "name": {
        "type": "string",
        "description": "Webhook name (1-80 chars, cannot contain 'discord')."
      }
    },
    "required": [
      "channel_id",
      "name"
    ]
  },
  "body_mapping": "params"
}
