{
  "name": "discord_create_role",
  "description": "Create a role. Provide `guild_id` and any of: `name`, `permissions` (bitfield as a decimal string), `color` (integer RGB), `hoist` (display separately), `mentionable`. Requires MANAGE_ROLES.",
  "method": "POST",
  "url": "https://discord.com/api/v10/guilds/{guild_id}/roles",
  "headers": {
    "Authorization": "Bot $DISCORD_BOT_TOKEN",
    "Content-Type": "application/json"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "guild_id": {
        "type": "string",
        "description": "The guild (server) ID (snowflake)."
      },
      "name": {
        "type": "string",
        "description": "Role name (defaults to 'new role')."
      },
      "permissions": {
        "type": "string",
        "description": "Permission bitfield as a decimal string (e.g. \"268435456\")."
      },
      "color": {
        "type": "integer",
        "description": "Integer RGB color (e.g. 0xFF0000 = 16711680)."
      },
      "hoist": {
        "type": "boolean",
        "description": "Whether members with this role are shown separately."
      },
      "mentionable": {
        "type": "boolean",
        "description": "Whether the role can be @mentioned."
      }
    },
    "required": [
      "guild_id"
    ]
  },
  "body_mapping": "params"
}
