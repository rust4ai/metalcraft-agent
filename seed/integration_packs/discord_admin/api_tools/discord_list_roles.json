{
  "name": "discord_list_roles",
  "description": "List all roles in a guild with their id, name, permissions bitfield, color, position, hoist, and mentionable flags. Provide `guild_id`.",
  "method": "GET",
  "url": "https://discord.com/api/v10/guilds/{guild_id}/roles",
  "headers": {
    "Authorization": "Bot $DISCORD_BOT_TOKEN",
    "Content-Type": "application/json"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "guild_id": {
        "type": "string",
        "description": "The guild (server) ID (snowflake)."
      }
    },
    "required": [
      "guild_id"
    ]
  },
  "body_mapping": "none"
}
