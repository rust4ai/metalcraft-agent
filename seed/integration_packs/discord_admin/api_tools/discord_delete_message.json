{
  "name": "discord_delete_message",
  "description": "Delete a single message. Provide `channel_id` and `message_id`. Requires MANAGE_MESSAGES (unless deleting the bot's own message).",
  "method": "DELETE",
  "url": "https://discord.com/api/v10/channels/{channel_id}/messages/{message_id}",
  "headers": {
    "Authorization": "Bot $DISCORD_BOT_TOKEN",
    "Content-Type": "application/json"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "channel_id": {
        "type": "string",
        "description": "The channel ID (snowflake)."
      },
      "message_id": {
        "type": "string",
        "description": "The message ID (snowflake)."
      }
    },
    "required": [
      "channel_id",
      "message_id"
    ]
  },
  "body_mapping": "none"
}
