{
  "name": "discord_list_guild_invites",
  "description": "List a guild's active invites with codes, inviters, channels, uses, and expiry. Provide `guild_id`. Requires MANAGE_GUILD.",
  "method": "GET",
  "url": "https://discord.com/api/v10/guilds/{guild_id}/invites",
  "headers": {
    "Authorization": "Bot $DISCORD_BOT_TOKEN",
    "Content-Type": "application/json"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "guild_id": {
        "type": "string",
        "description": "The guild (server) ID (snowflake)."
      }
    },
    "required": [
      "guild_id"
    ]
  },
  "body_mapping": "none"
}
