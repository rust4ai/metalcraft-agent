{
  "name": "discord_remove_ban",
  "description": "Remove (revoke) a ban, allowing the user to rejoin. Provide `guild_id` and `user_id`. Requires BAN_MEMBERS.",
  "method": "DELETE",
  "url": "https://discord.com/api/v10/guilds/{guild_id}/bans/{user_id}",
  "headers": {
    "Authorization": "Bot $DISCORD_BOT_TOKEN",
    "Content-Type": "application/json"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "guild_id": {
        "type": "string",
        "description": "The guild (server) ID (snowflake)."
      },
      "user_id": {
        "type": "string",
        "description": "The user ID (snowflake)."
      }
    },
    "required": [
      "guild_id",
      "user_id"
    ]
  },
  "body_mapping": "none"
}
