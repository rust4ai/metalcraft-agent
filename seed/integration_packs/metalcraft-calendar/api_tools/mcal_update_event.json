{
  "name": "mcal_update_event",
  "description": "Update an event by `id` in a calendar (`calendar` slug). This REPLACES the event's fields, so pass the complete intended state — title, starts_at and ends_at are always required, not just what you're changing. To change one field, first call mcal_get_event and resend the other values unchanged. Times are UTC ISO-8601. Requires the write scope (403 otherwise). The change is pushed to the linked Google calendar. Returns the updated event.",
  "method": "PATCH",
  "url": "https://calendar.metalcraftai.com/api/v1/calendars/{calendar}/events/{id}",
  "headers": {
    "Authorization": "Bearer $METALCRAFT_TOKEN",
    "Content-Type": "application/json",
    "Accept": "application/json"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "calendar": { "type": "string", "description": "Calendar slug." },
      "id": { "type": "string", "description": "Event id (UUID) to update." },
      "title": { "type": "string", "description": "Event title (required — resend to keep)." },
      "starts_at": { "type": "string", "description": "Start time, UTC ISO-8601 (required)." },
      "ends_at": { "type": "string", "description": "End time, UTC ISO-8601 (required)." },
      "all_day": { "type": "boolean", "description": "All-day flag (default false)." },
      "description": { "type": "string", "description": "Optional description / notes." },
      "location": { "type": "string", "description": "Optional location." }
    },
    "required": ["calendar", "id", "title", "starts_at", "ends_at"]
  },
  "body_mapping": "params"
}
