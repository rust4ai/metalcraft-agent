{
  "name": "sprite_builder_list_docuspaces",
  "description": "List a project's docuspaces.",
  "method": "GET",
  "url": "$SPRITE_BUILDER_BASE_URL/api/projects/{project_id}/docuspaces",
  "headers": {
    "Authorization": "Bearer $SPRITE_BUILDER_API_KEY"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "project_id": {
        "type": "string",
        "description": "The project's id (UUID, from sprite_builder_list_projects / sprite_builder_create_project)."
      }
    },
    "required": [
      "project_id"
    ]
  },
  "body_mapping": "none"
}
