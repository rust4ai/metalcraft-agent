{
  "name": "sprite_builder_get_docuspace",
  "description": "Get a docuspace by id.",
  "method": "GET",
  "url": "$SPRITE_BUILDER_BASE_URL/api/docuspaces/{docuspace_id}",
  "headers": {
    "Authorization": "Bearer $SPRITE_BUILDER_API_KEY"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "docuspace_id": {
        "type": "string",
        "description": "The docuspace's id (UUID, from sprite_builder_create_docuspace / sprite_builder_list_docuspaces)."
      }
    },
    "required": [
      "docuspace_id"
    ]
  },
  "body_mapping": "none"
}
