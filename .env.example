# metalcraft-agent environment template. Copy to `.env` and fill in.
# The daemon loads .env on startup (dotenvy). The ONLY required var is OPENAI_API_KEY.

# ── Required ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Workshop API (HTTP server + inbound webhooks) ────────────────────────────
# Two ways to enable the /api/v1/* API (leave BOTH unset to run the flow
# scheduler only, no HTTP server):
#   1. Static key — set WORKSHOP_API_KEY to a long random secret; it's the
#      Bearer token for /api/v1/*. Simplest for a self-hosted agent.
#   2. OIDC-only — set WORKSHOP_API_ENABLED=1 (or pass --api-oidc) to serve
#      keyless, authenticating Metalcraft ID tokens instead: an owner PAT
#      (mck_…) or an audience-scoped `pod:{slug}` connection token. This is how
#      the k3s control plane provisions pods. If WORKSHOP_API_KEY is also set,
#      both paths work.
# WORKSHOP_API_KEY=
# WORKSHOP_API_ENABLED=1
# PORT=3002                 # port the API binds on 0.0.0.0 (WORKSHOP_API_PORT also works)

# ── Agent / flow settings (optional; CLI flags override these) ───────────────
# METALCRAFT_MODEL=gpt-5.4  # model for the daemon, Workshop chats, and flows
#                           # (STARKBOT_MODEL also honored; the CLI reads OPENAI_MODEL)
# OPENAI_BASE_URL=          # route inference through a gateway, e.g. an OpenAI-
#                           # compatible endpoint (default: OpenAI directly)
# STARKBOT_PERSONA=coding-agent
# STARKBOT_POLL_SECONDS=30  # flow scheduler poll interval
# STARKBOT_FLOWS_DIR=       # defaults to <data dir>/flows
# STARKBOT_AUTO_APPROVE=true
# STARKBOT_ONCE=false

# ── Storage / runtime ────────────────────────────────────────────────────────
# METALCRAFT_DATA_DIR=/data # personas/skills/flows/chats/keys live here
# RUST_LOG=info
# TZ=UTC                    # affects cron-scheduled flows

# ── Metalcraft ecosystem token (notes, calendar, … packs) ────────────────────
# A Metalcraft ID PAT (mck_…) with the `write` scope. Set it and the first-party
# integration packs authenticate automatically — no keys.json entry needed.
# This var is ENV-AUTHORITATIVE: an injected value always wins over any stored
# key, because the k3s control plane provisions it per-pod and rotates it. When
# running your own agent, mint one at https://id.metalcraftai.com/account.
# METALCRAFT_TOKEN=mck_...
#
# POD_PUBLIC_URL — the pod's own externally reachable https URL. Injected by the
# k3s control plane; used to identify the pod (its `pod:{slug}` token audience)
# and as the gateway webhook base. Not needed for a self-hosted agent.
# POD_PUBLIC_URL=https://<slug>.pods.metalcraftai.com

# ── Sprite Builder pack (only if you use that integration) ───────────────────
# SPRITE_BUILDER_BASE_URL=
# SPRITE_BUILDER_API_KEY=

# ── Caddy / docker-compose.caddy.yml only ────────────────────────────────────
# DOMAIN=agent.example.com
# TLS_EMAIL=you@example.com

# Note: gateway-channel credentials (e.g. TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN)
# are NOT set here — store them via the key store API (PUT /api/v1/keys/<NAME>).
