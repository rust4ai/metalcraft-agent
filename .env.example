# metalcraft-agent environment template. Copy to `.env` and fill in.
# The daemon loads .env on startup (dotenvy). The ONLY required var is OPENAI_API_KEY.

# ── Required ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Workshop API (HTTP server + inbound webhooks) ────────────────────────────
# Set WORKSHOP_API_KEY to a long random secret to enable the API. Leave it
# unset to run the flow scheduler only (no HTTP server). It also acts as the
# Bearer token for /api/v1/* requests.
# WORKSHOP_API_KEY=
# PORT=3002                 # port the API binds on 0.0.0.0 (WORKSHOP_API_PORT also works)

# ── Agent / flow settings (optional; CLI flags override these) ───────────────
# OPENAI_MODEL=gpt-5.4      # or STARKBOT_MODEL
# STARKBOT_PERSONA=coding-agent
# STARKBOT_POLL_SECONDS=30  # flow scheduler poll interval
# STARKBOT_FLOWS_DIR=       # defaults to <data dir>/flows
# STARKBOT_AUTO_APPROVE=true
# STARKBOT_ONCE=false

# ── Storage / runtime ────────────────────────────────────────────────────────
# METALCRAFT_DATA_DIR=/data # personas/skills/flows/chats/keys live here
# RUST_LOG=info
# TZ=UTC                    # affects cron-scheduled flows

# ── Sprite Builder pack (only if you use that integration) ───────────────────
# SPRITE_BUILDER_BASE_URL=
# SPRITE_BUILDER_API_KEY=

# ── Caddy / docker-compose.caddy.yml only ────────────────────────────────────
# DOMAIN=agent.example.com
# TLS_EMAIL=you@example.com

# Note: gateway-channel credentials (e.g. TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN)
# are NOT set here — store them via the key store API (PUT /api/v1/keys/<NAME>).
